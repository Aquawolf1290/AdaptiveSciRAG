# LLM provider: "ollama" (default, free local) or "bedrock" (AWS Claude)
LLM_PROVIDER=ollama
FRONTEND_ORIGIN=http://localhost:5173

# --- Ollama (local) settings ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=qwen3-vl:8b

# --- Embedding models (local, free) ---
TEXT_EMBED_MODEL=BAAI/bge-small-en-v1.5
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k

# --- Retrieval settings ---
TOP_K_TEXT=5
TOP_K_IMAGES=3
ENABLE_IMAGE_RETRIEVAL=true

# --- Storage paths (relative to repo root) ---
DATA_DIR=data
CHROMA_DIR=data/chroma

# --- Bedrock (optional, only used when LLM_PROVIDER=bedrock) ---
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# AWS credentials are read from the standard AWS chain (env, ~/.aws/credentials, etc.)
